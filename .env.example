# Domain of the statistics portal (Nuxt app serving /api/indikator-*).
# Defaults to statistik.bs.ch when unset. Copy this file to .env to override.
STATISTIK_PORTAL_DOMAIN=statistik.bs.ch

# Seconds the indicator index (~2 MB) is kept in memory before refetching.
INDEX_CACHE_TTL=3600

# Optional: enables the search_portal tool (articles, tables, OGD, ...).
# Use a Meilisearch key with ONLY the "search" action on the "product" index,
# never an admin/master key.
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Host header allowed past DNS-rebinding protection on the MCP HTTP endpoint.
# Add the public hostname(s) this deployment is served under (comma-separated,
# port wildcard allowed), e.g. MCP_ALLOWED_HOSTS="mcp.bs.ch:*". Leave empty or
# unset to disable Host validation.
MCP_ALLOWED_HOSTS=
